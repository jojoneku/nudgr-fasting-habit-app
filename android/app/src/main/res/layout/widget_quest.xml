<?xml version="1.0" encoding="utf-8"?>
<!-- Quests glance widget. The card deep-links to quests; the inline ✓ completes
     the next quest via a background action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUESTS"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quest_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/quest_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quest_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_quest_done"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn_primary"
            android:text="✓"
            android:textColor="@color/widget_accent_on"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Signed-out state -->
    <TextView
        android:id="@+id/quest_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open the app to sign in"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
