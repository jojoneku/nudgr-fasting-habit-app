<?xml version="1.0" encoding="utf-8"?>
<!-- Weight glance widget. The card deep-links to the weight log. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weight_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WEIGHT"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/weight_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/weight_delta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <!-- Signed-out state -->
    <TextView
        android:id="@+id/weight_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open the app to sign in"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
