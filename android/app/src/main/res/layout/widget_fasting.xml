<?xml version="1.0" encoding="utf-8"?>
<!-- Fasting flagship widget (Plan 039). The Chronometer ticks natively while the
     app is killed; Start/End fire inline actions. Visibility is toggled by
     FastingWidgetProvider based on the pushed snapshot.

     Layout defaults below ARE the empty/uninitialized state: content is
     vertically centred (weighted spacer) so it fills any card size instead of
     hugging the top, and the card defaults to a clean "Ready to fast" look
     (Chronometer + progress hidden) so it never shows a half-rendered state
     before the first snapshot push. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fasting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fasting_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FASTING"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fasting_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_purple"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Centred content: fills the card vertically so a tall card has no dead
         space. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Live clock (fasting) -->
        <Chronometer
            android:id="@+id/fasting_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Idle state (default) -->
        <TextView
            android:id="@+id/fasting_idle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to fast"
            android:textColor="@color/widget_on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/fasting_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Footer: streak + action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fasting_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to begin"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/widget_btn_primary"
            android:text="Start Fast"
            android:textAllCaps="false"
            android:textColor="@color/widget_accent_on"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_end"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="96dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/widget_btn_outline"
            android:text="End Fast"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Signed-out state -->
    <TextView
        android:id="@+id/fasting_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open the app to sign in"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
