<?xml version="1.0" encoding="utf-8"?>
<!-- Food glance widget (Plan 039). Taps deep-link to the nutrition screen.
     Content is vertically centred (weighted spacer) so it fills the card, and
     value rows carry zero defaults so the widget never renders blank before the
     first snapshot push. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/food_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- TEMP DIAGNOSTIC default: if the widget ever shows "STATIC" the
             provider's onUpdate never ran (OS blocked it / render crashed). The
             live render always overwrites this. Restore to "0 kcal" after. -->
        <TextView
            android:id="@+id/food_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATIC"
            android:textColor="@color/widget_on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/food_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/food_protein"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Protein 0 g"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/food_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Open the app to sign in"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
