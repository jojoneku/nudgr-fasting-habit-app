<?xml version="1.0" encoding="utf-8"?>
<!-- Weight glance widget config. The 30-min update period (the OS minimum) is a
     backstop so the system re-renders the widget from the last-pushed snapshot
     even when the app's own update broadcast doesn't fire (e.g. aggressive OEM
     battery managers) — matching the other glance widgets. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_weight"
    android:previewLayout="@layout/widget_weight"
    android:updatePeriodMillis="1800000" />
